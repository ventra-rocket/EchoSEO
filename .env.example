# -----------------------------------------------------------------------------
# Core settings
# -----------------------------------------------------------------------------
# Required for all modes. See README.md for setup instructions.
# DATAFORSEO_API_KEY=

# Optional app port
# PORT=3001

# Optional reverse-proxy hosts for Docker self-hosting
# ALLOWED_HOST=yourdomain.com

# Optional image tag override for Docker self-hosting
# OPEN_SEO_IMAGE=ghcr.io/every-app/open-seo:latest

# -----------------------------------------------------------------------------
# Auth mode
# -----------------------------------------------------------------------------
# - hosted: public SaaS accounts with Better Auth email/password
# - cloudflare_access: private, operator-only deployment behind Cloudflare Access
# - local_noauth: local trusted mode with injected admin user (admin@localhost)
#
# The managed EchoSEO SaaS uses hosted mode. Use cloudflare_access only when
# deliberately running a private self-hosted instance for a known team.
#
# AUTH_MODE=hosted

# Required when AUTH_MODE=cloudflare_access
# TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# POLICY_AUD=your-cloudflare-access-aud-tag

# Required when AUTH_MODE=hosted
# BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# BETTER_AUTH_URL=http://localhost:3001
# RESEND_API_KEY=replace-with-your-resend-api-key
# AUTH_EMAIL_FROM=EchoSEO <noreply@example.com>
#
# Google is optional. Add these only when enabling Google Search Console.
# GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# GOOGLE_AUTH_ENABLED=true
#
# Required for the public Free SEO Checker. The site key is browser-visible;
# the matching secret must stay server-only.
# TURNSTILE_SITE_KEY=replace-with-your-turnstile-site-key
# TURNSTILE_SECRET_KEY=replace-with-your-turnstile-secret-key
#
# PostHog is optional product analytics.
# POSTHOG_PUBLIC_KEY=replace-with-your-posthog-project-api-key
# POSTHOG_HOST=https://us.i.posthog.com
#
# Billing deferral (hosted mode, before the Autumn provider is configured):
# - AUTUMN_SECRET_KEY absent  => paid/managed gates degrade to a clean
#   PAYMENT_REQUIRED instead of a 500 (never a try/catch — a present-but-broken
#   key still fails loudly).
# - HOSTED_ACCESS_OPEN=true    => paywall + forced onboarding off globally.
# - CORE_ACCESS_ALLOWLIST      => comma-separated org IDs granted the
#   paid/managed core features (Site Audit, rank checks, AI Visibility) while
#   billing is deferred. Empty/unset = no one (fail-closed).
# AUTUMN_SECRET_KEY=replace-with-your-autumn-secret-key
# HOSTED_ACCESS_OPEN=true
# CORE_ACCESS_ALLOWLIST=org_your_id,org_invited_user_id

# Optional in self-hosted modes. Required if you want Google Search Console
# integration and MCP tools. BETTER_AUTH_SECRET is also required for GSC (it
# encrypts the stored OAuth tokens). See docs/SELF_HOSTING_GOOGLE_SEARCH_CONSOLE.md.
# GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
