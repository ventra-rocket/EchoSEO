{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-seo",
  "main": "src/server.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
  },
  // Secure default: validate Cloudflare Access JWTs. The Access app + allow
  // policy live in the ventrarocket Zero Trust org; POLICY_AUD and TEAM_DOMAIN
  // are set as Worker secrets.
  "vars": {
    "AUTH_MODE": "cloudflare_access",
  },
  // EchoSEO deploys to its own zone (ventrarocket.vn) as a custom domain.
  // workers_dev is disabled so deploys don't require a workers.dev subdomain.
  "routes": [{ "pattern": "echoseo.ventrarocket.vn", "custom_domain": true }],
  "workers_dev": false,
  "workflows": [
    {
      "name": "site-audit-workflow",
      "binding": "SITE_AUDIT_WORKFLOW",
      "class_name": "SiteAuditWorkflow",
    },
    {
      "name": "rank-check-workflow",
      "binding": "RANK_CHECK_WORKFLOW",
      "class_name": "RankCheckWorkflow",
    },
    {
      "name": "deep-seo-check-workflow",
      "binding": "DEEP_SEO_CHECK_WORKFLOW",
      "class_name": "DeepSeoCheckWorkflow",
    },
  ],
  // Durable Objects: onboarding chat (Agents SDK AIChatAgent, one instance per
  // project) and the free SEO checker's per-IP rate limiter (one instance per
  // IP, see src/server/services/seo-check/rate-limit-do.ts). Both are
  // SQLite-backed, so their classes must be declared in `migrations` below.
  "durable_objects": {
    "bindings": [
      {
        "name": "ONBOARDING_CHAT",
        "class_name": "OnboardingChatAgent",
      },
      {
        "name": "RATE_LIMIT_DO",
        "class_name": "IpRateLimiterDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OnboardingChatAgent"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["IpRateLimiterDO"],
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "056fb7db45e34abeafb0840fd7505755",
    },
    {
      "binding": "OAUTH_KV",
      "id": "e159e65cfee3497baa826e9982bd73b9",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-seo",
      "database_id": "cc386283-18b3-4b19-b4f6-a9954c5d0594",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "open-seo",
      "binding": "R2",
    },
  ],
}
