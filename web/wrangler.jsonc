{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "echoseo-landing",
  "compatibility_date": "2026-02-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "assets": {
    "directory": "./dist/client",
    "html_handling": "drop-trailing-slash",
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  // Marketing landing owns the apex (echoseo.ventrarocket.vn); www is kept as a
  // mirror. Deploying this worker reassigns the apex custom domain here from the
  // app worker (workers-sdk #13925) — the app now lives on app.echoseo.ventrarocket.vn.
  "routes": [
    {
      "pattern": "echoseo.ventrarocket.vn",
      "custom_domain": true,
    },
    {
      "pattern": "www.echoseo.ventrarocket.vn",
      "custom_domain": true,
    },
  ],
  "env": {
    "preview": {
      "name": "echoseo-landing-preview",
      "workers_dev": true,
      "preview_urls": true,
    },
  },
}
